# Private operator-only migration inputs. Use an existing database, not a new add-on.
MIGRATION_DATABASE_URL=
# Optional operator connection for schema ownership/import; never sent to Heroku.
MIGRATION_ADMIN_DATABASE_URL=
SOURCE_DATABASE_URL=
SOURCE_ARTIFACT_DIR=
DATA_SCHEMA=coa_puroseka
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Runtime model configuration: passed only to chat.
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-latest
# Generated locally by deploy_heroku.py when absent; never publish their values.
LOGIN_SERVICE_TOKEN=
ONTOLOGY_SERVICE_TOKEN=
# Optional separate least-privilege runtime roles supplied by the existing provider.
LOGIN_DATABASE_URL=
ONTOLOGY_DATABASE_URL=
CHAT_DATABASE_URL=
# Exact frontend origin accepted by the browser API; no wildcard origins.
PUBLIC_ORIGIN=https://chat.coa.puroseka.02labs.me
# For manual local service startup, set DATABASE_URL (ontology) or
# CONTROL_DATABASE_URL (login/chat), COA_SERVICE, ARTIFACT_STORE=database,
# PUBLIC_ORIGIN, and the appropriate *_SERVICE_URL / *_SERVICE_TOKEN variables.
